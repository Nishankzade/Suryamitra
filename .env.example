# ============================================================
# SURYAMITRA AI — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!
# ============================================================

# --- ANTHROPIC API (Get from console.anthropic.com) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- NEON DATABASE (Get from neon.tech) ---
DATABASE_URL=your_neon_database_url_here

# --- JWT SECRET (Generate a random 64-char string) ---
# Run this in terminal to generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-64-characters-long-random-string

# --- APP URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OPTIONAL: Google OAuth (for Google login button) ---
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
